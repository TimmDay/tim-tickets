# GCP Firestore service account
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Shared password gate
APP_PASSWORD=
APP_SESSION_SECRET=

# Agent runs ("Release the bots")
# Fine-grained GitHub PAT with Contents: read & write on the repos epics point at
GITHUB_DISPATCH_TOKEN=
# Random secret agent workflows send back as a bearer token (also set as a repo secret)
AGENT_API_TOKEN=
# Optional: public base URL agent workflows report back to, overriding the page's origin.
# Set to a tunnel URL (e.g. https://xyz.trycloudflare.com) when dispatching from local dev.
AGENT_REPORT_BASE_URL=
